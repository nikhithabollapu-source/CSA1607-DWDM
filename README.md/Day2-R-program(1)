# 1. Sample covariance between B and C
B <- c(22, 28, 10)
C <- c(20, 40, 40)

cov(B, C)

# 2. Sample covariance matrix
A <- c(18, 2, 20)
B <- c(22, 28, 10)
C <- c(20, 40, 40)

preferences <- data.frame(A, B, C)
cov(preferences)

# 3. Sample correlation between B and C
cor(B, C)

# 4. Sample correlation matrix
cor(preferences)
